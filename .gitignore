# JetBrains Rider plugin generated by Unity
/Assets/Plugins/Editor/JetBrains*

# Crash reports
sysinfo.txt

# Build artifacts
*.apk
*.aab
*.app
*.ipa
*.unitypackage

# Autogenerated Asset Store tools
/Assets/AssetStoreTools*

# Gradle cache from exported Android projects
.gradle/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Keep Unity .meta files tracked alongside their assets.
!/[Aa]ssets/**/*.meta
