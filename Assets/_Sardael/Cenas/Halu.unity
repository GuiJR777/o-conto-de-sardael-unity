  m_Script: {fileID: 11500000, guid: 51220700e2762df49bd48104f59f8012, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Sardael.DiretorDeHalu
  sardael: {fileID: 1208792883}
  comandoDoHeroi: {fileID: 1208792886}
  mensageira: {fileID: 865473471}
  lider: {fileID: 1378756109}
  caixaDeFala: {fileID: 380996487}
  pontoDoChefe: {fileID: 705344549}
  portaDoTutorial: {fileID: 728735803}
  portaDaFloresta: {fileID: 1449619929}
  xMaximoDepoisDeBael: 156
  mensageiraCorrendo: {fileID: 3094330708855449807, guid: 6deac83e30d8acd4cbb8c7d8a11545bd, type: 3}
  mensageiraFalando: {fileID: 3094330708855449807, guid: 5277e5180e302184fb73653674a14c85, type: 3}
  mensageiraAndando: {fileID: 3094330708855449807, guid: c133e3c197c12e04a9dd23bd0966910f, type: 3}
  mensageiraParada: {fileID: -2576967968662016515, guid: 56fd86b76fc74d24d83522069f5deb9b, type: 3}
  velocidadeCorrendo: 3.7953746
  velocidadeAndando: 1.8976876
  esperaInicial: 1
  xDePartida: 14
  distanciaDaParada: 2.8
  nomeDaMensageira: Mensageira
  recado: "Sardael! O l\xEDder dos veados te convoca \u2014 agora. Ele est\xE1 no
    centro da aldeia."
  duracaoDoRecado: 4.5
  quantoElaSeAfasta: 16
  distanciaQueAbreAConversa: 3.2
  nomeDoLider: "L\xEDder dos Veados"
  falaDoLider1: "A fazenda leste est\xE1 sob ataque. Orcs \u2014 muitos deles."
  falaDoLider2: "O capit\xE3o de Vald\xF3ria j\xE1 est\xE1 l\xE1. Encontre-o. V\xE1
    pelo port\xE3o oeste, e depressa."
  duracaoDeCadaFala: 4.2
  falaDeBael1: "A fazenda resistiu. Mas o que veio de l\xE1 n\xE3o veio sozinho."
  falaDeBael2: A Floresta de Bael guarda a raiz disso. Siga para o sul, Sardael.
  pontoDeChegadaDoTutorial: {fileID: 0}
  folgaDoPortao: 3
  grupoDeAcordar: {fileID: 1817964390}
  diretorDeAcordar: {fileID: 863341415}
  cameraDoJogo: {fileID: 1302360519}
  pausaDepoisDeAcordar: 1.2
  nomeDeSardael: Sardael
  falaDoSonho: "Chefe, tive um sonho estranho. Os povos m\xEDsticos atacavam Halu."
  respostaDoChefe: "N\xE3o foi sonho, Sardael. O que est\xE1 esperando para ir para
    Bael?"
  falaDoSonhoDeNovo: Chefe... o mesmo sonho. De novo.
  respostaDoChefeDeNovo: "E continua n\xE3o sendo sonho. Bael, Sardael. Agora."
  mostrarPainel: 1
  sempreDoComeco: 0
